{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨洞 InkHole",
  "version": "2.0.9",
  "identifier": "com.rexvane.inkhole",
  "build": {
    "beforeDevCommand": "node inkhole-desktop/scripts/frontend.mjs dev",
    "devUrl": "http://127.0.0.1:9245",
    "beforeBuildCommand": "node inkhole-desktop/scripts/frontend.mjs build",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.local"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../desktop/build/darwin/icon.icns",
      "../../../desktop/build/darwin/icon-32.png",
      "../../../desktop/build/darwin/icon-128.png",
      "../../../desktop/build/darwin/icon-256.png",
      "../../../desktop/build/darwin/icon-512.png",
      "../../../desktop/build/windows/icon.ico"
    ],
    "shortDescription": "跨平台文件传输 · 局域网自动发现"
  }
}
