<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 墨洞：径向渐变 墨黑核心 → 暗青过渡 → 亮青视界环 → 融回墨黑底 -->
    <!-- 半径 34（原 42）：缩小一圈，圆形遮罩下刚好不内切到边框 -->
    <path
        android:pathData="M54,54 m-34,0 a34,34 0,1 1,68 0 a34,34 0,1 1,-68 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34">
                <item android:offset="0.00" android:color="#FF000000"/>
                <item android:offset="0.45" android:color="#FF020807"/>
                <item android:offset="0.62" android:color="#FF0E3A32"/>
                <item android:offset="0.76" android:color="#FF58E6C8"/>
                <item android:offset="0.86" android:color="#FF144038"/>
                <item android:offset="1.00" android:color="#FF05070A"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
